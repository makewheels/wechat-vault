# 只列键名；真值从 Infisical 注入（tools/dev /wechat-vault）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
TABLESTORE_ENDPOINT=
TABLESTORE_INSTANCE=wechat-vault
OSS_BUCKET=wechat-vault
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
OSS_REGION=cn-beijing

# WeFlow（platform-accounts/dev /weflow）
WEFLOW_API=http://127.0.0.1:5031
WEFLOW_ACCESS_TOKEN=

# 可选：源标识，默认 mac
WECHAT_VAULT_SOURCE=mac

# 设备密钥只从 /wechat-vault/<wxid>/<device> 注入，禁止放在共享路径。
WECHAT_DB_KEY=
WECHAT_IMAGE_AES_KEY=
# deploy/run-mac.sh 使用的非敏感范围标识
WECHAT_ACCOUNT_ID=
WECHAT_DEVICE_ID=
