<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.makewheels.wechat-vault</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>cd /Users/mint/workspace/tools/wechat-vault &amp;&amp; sh deploy/run-mac.sh uv run python -u -m wechat_vault.direct_sync --account-root /Users/mint/Library/Containers/com.tencent.xinWeChat/Data/Documents/xwechat_files/wxid_vizj1s0qmxl922_2b0d</string>
	</array>
	<key>StartInterval</key>
	<integer>900</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/mint/Library/Logs/wechat-vault/out.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/mint/Library/Logs/wechat-vault/err.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>WECHAT_ACCOUNT_ID</key>
		<string>wxid_vizj1s0qmxl922</string>
		<key>WECHAT_DEVICE_ID</key>
		<string>mac-mint-mac-mini</string>
	</dict>
</dict>
</plist>
