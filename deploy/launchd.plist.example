<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.makewheels.wechat-archive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd /Users/mint/workspace/tools/wechat-archive &amp;&amp; infisical run --env=dev --path=/wechat-archive -- uv run wechat-archive sync --source mac</string>
  </array>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/mint/Library/Logs/wechat-archive/out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/mint/Library/Logs/wechat-archive/err.log</string>
</dict>
</plist>
